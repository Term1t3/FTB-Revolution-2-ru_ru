{
  "quest.7F0A4B19ED4DF750.quest_desc": [
    "Пять из восьми биомов мода Incendium. Посетите каждый из них."
  ],
  "quest.18DE042E91A96693.quest_desc": [
    "Мавзолеи, черные спирали, заброшенные руины, пещеры визеров и гниющие храмы скрывают &cСангвинического торговца&r.",
    "",
    "Ассортимент: руны и реагенты Neo Vitae, темные самоцветы и восковой уголь EvilCraft, а также кровавая жемчужина телепортации.",
    "{@pagebreak}",
    "&bМеста:&r Мавзолей, Черная спираль (Explorify), Заброшенная руина, Пещера визера, Гниющий храм (ATI)",
    "",
    "&dРазблокировка:&r Получите Ара Витаэ"
  ],
  "quest.167F48E2584A3022.title": "&cМог и Гулг",
  "quest.506CE8202884EF43.quest_desc": [
    "Биом Энда Resonance, полный огромных жеод и аметистовых шпилей."
  ],
  "quest.7638D24AFD676A7F.quest_desc": [
    "Джунглевые храмы Моуга намного больше ванильных, а сокровищницу охраняет головоломка.",
    "",
    "Решите ее, чтобы получить хороший шанс найти Тотем бессмертия или Зачарованное золотое яблоко."
  ],
  "quest.15DA8CCB11B85EA6.quest_desc": [
    "Ищите каменный храм на поверхности. Шахта под ним ведет в большое подземелье на глубине примерно 47 блоков.",
    "",
    "Сундуки с добычей делятся на пять уровней, а в легендарных могут выпасть доспехи и инструменты божественного уровня с зачарованиями, значительно превышающими их обычный максимум.",
    "",
    "&cНекоторые сундуки заминированы динамитом."
  ],
  "quest.170CF50988CB58E6.quest_desc": [
    "Небесные арены парят на высоте от y 120 до y 170. Они работают подобно камерам испытаний, со спавнерами испытаний, из которых выпадают ключи испытаний для хранилищ.",
    "",
    "В хранилищах хранятся алмазное снаряжение и отделка для брони «Болт», а также гарантированная Зловещая бутыль."
  ],
  "quest.5AB13D8A178233DD.quest_desc": [
    "Крепости здесь представляют собой перестроенные версии, наполненные спавнерами, библиотеками и арсеналами, а внизу по-прежнему ждет комната с порталом в Энд.",
    "",
    "Око Энда приведет вас к одной из них, как обычно."
  ],
  "quest.388CACAF16133436.quest_desc": [
    "Озера с желтыми, оранжевыми и черными берегами, с лавой и жерлами между ними. Смотрите, куда ступаете."
  ],
  "quest.409A27E9A4A6941D.quest_desc": [
    "Вытяните перевернутую карту таро «Смерть», и с каждым наступлением ночи будет 15% шанс призвать саму &cСмерть&r.",
    "",
    "У нее 1000 здоровья, и ни один одиночный удар по ней не наносит более 16 урона. Она сбрасывает свой капюшон, робу, обувь и косу."
  ],
  "quest.34FF9A882AA4ABCB.title": "&3Древние города",
  "quest.55B3900E2E519129.quest_desc": [
    "Небольшие корабли и древние судна перевозят &9Лихого рубаку&r.",
    "",
    "Ассортимент: огнестрельное оружие, боеприпасы и модификаторы оружия Iron's Arms 'n Artifice, а также динамит и ящик с добычей.",
    "{@pagebreak}",
    "&bМеста:&r Маленький корабль (MVS), Древнее судно (ATi)",
    "",
    "&dРазблокировка:&r Победите Стрелка или выиграйте дуэль со стрелком"
  ],
  "quest.7F59F90B1B6F9A67.title": "&bЛедяной дракон",
  "quest.7AE9316511656205.quest_subtitle": "Странник, ювелир и мастер зверей",
  "quest.4E77F883F5F8C4E7.quest_subtitle": "Квартирмейстер, механик, бакалейщик и пчеловод",
  "quest.20393692539B1184.quest_desc": [
    "Жуткие мавзолеи стоят в заснеженных биомах, кишеющие жуткими спавнерами. Дверь остается запертой, пока вы не принесете ключ."
  ],
  "quest.19ADE41D01CF22B7.title": "&dЭлектрический дракон",
  "quest.7465320331494BD7.title": "&6Пещеры драконов",
  "quest.6B87A87B53F85BD4.title": "&9Лунная роща",
  "quest.21D5042B16907B90.quest_desc": [
    "Подводная версия каменных подземелий, построенная под дном океана на глубине от y -24 до y 24. Ее охраняют спавнеры стражей, утопленников и бродяг.",
    "",
    "Ее сундуки с добычей добавляют океанское снаряжение к обычным пяти уровням."
  ],
  "quest.269CA7E3614C0826.quest_desc": [
    "Морские змеи охотятся в открытом океане и нападают на лодки. Древние достигают 270 единиц здоровья."
  ],
  "quest.5758A01C78625749.quest_desc": [
    "Ищите &2Лесную ведьму&r в хижинах ведьм, мангровых хижинах, маленьких болотных домиках и поселениях темного леса.",
    "",
    "Ассортимент: припасы Witchery и Roots Classic, включая семена ведьминских растений, тег-локи, куклы, ритуальный мел и Мутандіс.",
    "{@pagebreak}",
    "&bМеста:&r Хижина ведьмы (Terralith), Мангровая хижина (Explorify), Маленький болотный домик (MVS), Поселение темного леса (Explorify)",
    "",
    "&dРазблокировка:&r Получите путеводитель по Witchery или Зеленую ветвь"
  ],
  "quest.2965565D68C9761B.quest_desc": [
    "Затонувший корабль с Варденом на борту и одиннадцатью сундуками для мародерства. Этот Варден также сбрасывает ключ от подземелья."
  ],
  "quest.7B828C91840C23A5.quest_desc": [
    "Парящий инферно — это ифрит с 700 здоровья и 20 броней, у него есть Тотем бессмертия, так что рассчитывайте убить его дважды.",
    "",
    "Из него выпадают два артефакта из &eIncendium&r."
  ],
  "quest.4FE64D008CCF0CA2.title": "&bНебесные земли",
  "quest.250945907CE6EA9D.quest_desc": [
    "Дракон ничего не сбрасывает после смерти. Нажмите на тушу правой кнопкой мыши, чтобы разделать ее, и каждая разделка принесет что-то новенькое.",
    "",
    "Сначала идут чешуя и кровь, так что захватите стеклянные бутылки. Затем следуют кости, затем сердце, а череп достается при последней разделке."
  ],
  "quest.693BD17350005AC9.title": "&dГолова горгоны",
  "quest.15DA8CCB11B85EA6.title": "&aКаменные подземелья",
  "quest.1F842D40F39C5763.quest_desc": [
    "Крупнейшие руины в глубоких океанах. Спавнеры испытаний утопленников охраняют сундуки с трезубцами, алмазным снаряжением и отделкой для брони «Побережье»."
  ],
  "quest.1F842D40F39C5763.title": "&3Подводный город",
  "quest.409A27E9A4A6941D.title": "&cСмерть",
  "quest.7D5121F9B867A99D.quest_desc": [
    "&cГромовержец&r имеет 350 здоровья и 10 брони, и он получает вдвое меньше урона, пока вызывает свою бурю.",
    "",
    "Из него выпадает полный комплект королевской брони и королевская глефа."
  ],
  "quest.42348582DFB34EA1.quest_desc": [
    "Incendium перестраивает Нижний мир. Пять ванильных биомов остаются на месте, к ним добавляются восемь новых."
  ],
  "quest.7AE9316511656205.quest_desc": [
    "Таверны Explorify — самая оживленная остановка на дороге, внутри находятся четыре лавочника.",
    "",
    "- &6Странник&r: туристическое снаряжение, от путеводных камней и свитков телепортации до компасов, параплана и кроссовок.",
    "- &dЮвелир&r: печати Apotheosis, футляры для самоцветов, фолианты и ремесленные свитки.",
    "- &cМастер зверей&r: детали для ферм мобов, пилоны, руны спавнера и спавнер монстров.",
    "",
    "Странник продает &aКомпас природы&r и &2Компас исследователя&r, которые находят все остальные места в этой главе.",
    "{@pagebreak}",
    "&bМесто:&r Таверна (Explorify)",
    "",
    "&dРазблокировка:&r ",
    "&6Странник&r - Получите камень варпа, параплан или компас природы/исследователя",
    "&dЮвелир&r - Постройте станцию ювелирного дела",
    "&cМастер зверей&r - Создайте бестиарий"
  ],
  "quest.73127D9218A217CB.title": "&cГидра",
  "quest.7F209ECB076B2B30.quest_desc": [
    "Мир полон сооружений, и в этой главе перечислены те, ради которых стоит отправиться в путь. Ожидайте подземелья, арены боссов и добычу, которую вы больше нигде не найдете.",
    "",
    "&aКомпас исследователя&r указывает на ближайшее сооружение любого выбранного вами типа на расстоянии до 10 000 блоков. Большинство квестов здесь выполняются, как только вы ступаете внутрь сооружения.",
    "",
    "&cДраконы, сирены, циклопы и другие опасные существа из Ice and Fire никогда не появляются ближе чем в 2 000 блоках от точки появления в мире."
  ],
  "quest.30C87E5D353137F6.quest_desc": [
    "Рогатые статуи прячутся под землей по всему Верхнему миру. Обменяйте их на изумруды и &aэссенцию&r, чтобы получить &2сосуд выносливости&r, который увеличивает выносливость вашего параплана.",
    "",
    "Они также выкупают сосуды обратно, если вы передумаете."
  ],
  "quest.42348582DFB34EA1.title": "&cНижний мир",
  "quest.6EFD9C957BD47563.quest_desc": [
    "Личи ужаса бродят по заснеженным биомам и с вероятностью один к десяти сбрасывают &bКлюч могильщика&r. Он открывает замочную скважину мавзолея.",
    "",
    "Внутри сундуков может храниться сердце ледяного дракона."
  ],
  "quest.6933686D0F959FAA.title": "&cОгненный дракон",
  "quest.6933686D0F959FAA.quest_desc": [
    "Дракон в логове имеет около 1100–1200 здоровья, а дыхание огненного дракона поджигает землю вокруг вас."
  ],
  "quest.7638D24AFD676A7F.title": "&aХрамы джунглей",
  "quest.569357C95D1210AA.quest_desc": [
    "Несколько шлюзов &eNautec&r уже находятся на дне океана, каждый на небольшой призмариновой платформе в открытом океане. Все они имеют одинаковый четырехцветный адрес.",
    "",
    "Нажмите правой кнопкой мыши пустой рукой на плавник, чтобы прочитать этот адрес. Построенный и перекрашенный в тон шлюз сможет связаться с ними."
  ],
  "quest.15C698B306B3B577.title": "&cЦиклоп",
  "quest.24D8E1226694FEED.title": "&cЛеонард",
  "quest.506CE8202884EF43.title": "&dКристаллический Энд",
  "quest.1BF72D9D4ECB46B8.quest_desc": [
    "Редкий сундук в Храме Нижнего мира всегда содержит шаблон обновления до незерита, что избавляет от долгих поисков бастиона."
  ],
  "quest.1D86C25D8DDA3F1E.title": "&cАрены Нижнего мира",
  "quest.1D96D2FF800AE80A.title": "&3Океанские храмы",
  "quest.15C698B306B3B577.quest_desc": [
    "У &cциклопа&r 250 здоровья, и он бьет больно. Стрела в глаз ослепляет его, а полный костюм овцы скрывает вас, пока вы крадетесь."
  ],
  "quest.4FE64D008CCF0CA2.quest_desc": [
    "Плавающие острова с озерами и водопадами, парящие над океаном. Terralith имеет весенние, летние, осенние и зимние версии, и любая из них засчитывается.",
    "",
    "&aКомпас природы&r находит любой биом по названию. Странник продает один такой."
  ],
  "quest.693BD17350005AC9.quest_desc": [
    "Взгляд &cгоргоны&r обращает вас в камень. Наденьте &aповязку на глаза&r или выпейте зелье слепоты, прежде чем спускаться вниз. Зеркала не помогут.",
    "",
    "У нее 120 здоровья, и из нее всегда выпадает ее голова."
  ],
  "quest.2C3ED0622537D3DD.title": "&cМега-крепость",
  "quest.6B9AD6056DC2E540.quest_desc": [
    "Пещеры циклопов высечены в пляжах, а сами циклопы также бродят по равнинам и лугам."
  ],
  "quest.1FF99FC384C22A24.quest_desc": [
    "Крупнейший схрон добычи в Энде с четырнадцатью сундуками сокровищами города Энда за гарнизоном шалкеров."
  ],
  "quest.40892A92CA977BA0.quest_desc": [
    "Склоны вулкана, с лавовыми источниками, текущими по его бокам."
  ],
  "quest.502E257ED1246812.quest_desc": [
    "Пещеры гидры вырыты на болотах и мангровых болотах."
  ],
  "quest.7465320331494BD7.quest_desc": [
    "Самые старые драконы спят в пещерах глубоко под землей, между y -24 и y 5, на гораздо больших сокровищах, чем любое гнездо.",
    "",
    "&cПещерные драконы могут иметь около 2500 здоровья."
  ],
  "quest.21D5042B16907B90.title": "&3Глубинносланцевые подземелья",
  "quest.2B5ECE4CD3F8412B.title": "&3Торговец рыбой",
  "quest.170CF50988CB58E6.title": "&aНебесные арены",
  "quest.2913824ED3340F93.title": "&3Руины Nautec",
  "quest.1A235CAF42A6F6A0.title": "&5Далекий Энд",
  "quest.34FF9A882AA4ABCB.quest_desc": [
    "Древние города здесь представляют собой более крупные переработанные версии, а в их сундуках находятся осколки эха, зачарованные золотые яблоки и отделка для брони «Тишина».",
    "",
    "Скричеры скалка призывают Вардена, и каждый Варден в этой сборке сбрасывает &dключ от подземелья Вардена&r."
  ],
  "quest.342991AE8AC9BC34.title": "&cЗапретный замок",
  "quest.5EBF7DD6E28CBBCD.quest_desc": [
    "Подземелья Dungeon Crawl уходят на пять уровней вниз, и самый глубокий уровень выполнен в тематике Нижнего мира. Спавнеры содержат вооруженных мобов, а секретные комнаты скрывают одни из лучших сундуков.",
    "",
    "Сокровищница приносит стопки золота и время от времени зачарованное золотое яблоко."
  ],
  "quest.124F536BB57E1365.quest_desc": [
    "Песня &cсирены&r манит вас к ней. Наденьте &aберуши&r, и она не сможет вас тронуть.",
    "",
    "Сирены сбрасывают слезы сирен и блестящую чешую."
  ],
  "quest.342991AE8AC9BC34.quest_desc": [
    "Глубоко в Пепельных пустошах стоит крупнейшая постройка &eIncendium&r. Бруты-пиглины и стражи-ифриты удерживают ее, а на ее подставках выставлены Алый кинжал или Двуручный меч жертвоприношения."
  ],
  "quest.1BF72D9D4ECB46B8.title": "&cХрам Нижнего мира",
  "quest.569357C95D1210AA.title": "&3Затонувшие шлюзы",
  "quest.49A2DD994F720F84.quest_desc": [
    "Версия каменных подземелий для Нижнего мира, между y 24 и y 90. Спавнеры ифритов, скелетов-иссушителей и брутов-пиглинов охраняют собственную элитную таблицу добычи."
  ],
  "quest.203E01E473B7DCFA.title": "&cРогатый егерь",
  "quest.33D0A75727D9CB58.quest_subtitle": "Привратник и игрок",
  "quest.656B7E686D7EBBE4.title": "&bГромовой двор",
  "quest.49A2DD994F720F84.title": "&cПодземелья Нижнего мира",
  "quest.7F59F90B1B6F9A67.quest_desc": [
    "Дыхание ледяного дракона замораживает все, к чему прикасается, включая вас. Двигайтесь, чтобы оно не могло пригвоздить вас к месту."
  ],
  "quest.5758A01C78625749.title": "&2Лесная ведьма",
  "quest.57A55BDA10B81ACB.title": "&dЭнд",
  "quest.57A55BDA10B81ACB.quest_desc": [
    "За основным островом большая часть внешнего Энда принадлежит биомам Nullscape и Resonance."
  ],
  "quest.5A03706C37C733CE.title": "&dЧародей",
  "quest.5AB13D8A178233DD.title": "&aКрепости",
  "quest.4E77F883F5F8C4E7.quest_desc": [
    "Лавочники обосновываются там, где им положено. Зайдите в деревню, и появятся до четырех из них, с сообщением в чате для каждого. Нажмите правой кнопкой мыши на лавочника пустой рукой, чтобы открыть его магазин.",
    "",
    "- &bКвартирмейстер&r: рюкзаки и улучшения хранилищ, ящики и начальные детали для AE2 и Refined Storage.",
    "- &cМеханик&r: детали машин из технологических модов и ячейки бесконечности.",
    "- &aБакалейщик&r: семена, урожай, яйца призыва сельскохозяйственных животных и кухонные инструменты.",
    "- &6Пчеловод&r: клетки для пчел, гнезда и улучшения ульев. Пчеловод приходит только в деревни в биомах равнин, равнин с подсолнухами, лугов и саванн.",
    "{@pagebreak}",
    "&bМесто:&r Деревни",
    "",
    "&dРазблокировка:&r ",
    "&bКвартирмейстер&r - Улучшите рюкзак или сундук для хранения",
    "&cМеханик&r - Создайте любую базовую схему",
    "&aБакалейщик&r - Что-нибудь съешьте",
    "&6Пчеловод&r - Поймайте пчелу в клетку для пчел"
  ],
  "quest.1754F4058CB200D4.title": "&dИскатель драконов",
  "quest.19ADE41D01CF22B7.quest_desc": [
    "Электрические драконы обрушивают удары своим дыханием. Они самые распространенные из трех, поэтому вы, скорее всего, встретите одного из них первыми."
  ],
  "quest.33D0A75727D9CB58.title": "&6Торговцы усадьбы",
  "quest.46EEC36A2FA7A0D0.title": "&dМиражные острова",
  "quest.388CACAF16133436.title": "&6Йеллоустоун",
  "quest.250945907CE6EA9D.title": "&6Разделка дракона",
  "quest.203E01E473B7DCFA.quest_desc": [
    "Создайте чучело из окровавленного сена и подожгите его с помощью кресала и кремня, и &cРогатый егерь&r откликнется.",
    "",
    "У него 150 здоровья, и с него падает копье егеря."
  ],
  "quest.1754F4058CB200D4.quest_desc": [
    "&dИскатель драконов&r указывает на ближайшего дракона. Его радиус действия увеличивается со 150 до 500 блоков по мере его улучшения.",
    "",
    "Он находит драконов только в загруженных чанках, так что используйте его на ходу."
  ],
  "quest.656B7E686D7EBBE4.quest_desc": [
    "Громовые дворы стоят на равнинах, лугах и в лесах, и каждый из них содержит одного &cгромовержца&r."
  ],
  "quest.7F0A4B19ED4DF750.title": "&cДикие земли Нижнего мира",
  "quest.7EE3B916522A9170.title": "&aХрам горгоны",
  "quest.5EBF7DD6E28CBBCD.title": "&aПоход по подземельям",
  "quest.2B5ECE4CD3F8412B.quest_desc": [
    "Подводные храмы содержат магазин &3торговца рыбой&r.",
    "",
    "Рыболовные снасти и наживка для Starcatcher, детали Nautec и культуры бактерий, а также аквариумы.",
    "",
    "Возьмите с собой средство для дыхания под водой.",
    "{@pagebreak}",
    "&bМеста:&r Подводный деревенский храм (целый, сломанный или разрушенный)",
    "",
    "&dРазблокировка:&r Поймать рыбу"
  ],
  "quest.7AE9316511656205.title": "&6Посетители таверны",
  "quest.1D86C25D8DDA3F1E.quest_desc": [
    "Камеры испытаний для Нижнего мира со спавнерами испытаний скелетов-иссушителей, ифритов и магмовых кубов, охраняющими хранилища.",
    "",
    "Хранилища редкой арены драконов могут содержать тяжелое ядро."
  ],
  "quest.7B828C91840C23A5.title": "&6Парящий инферно",
  "quest.7D5121F9B867A99D.title": "&6Громовержец",
  "quest.2C3ED0622537D3DD.quest_desc": [
    "Огромная крепость, которая может появиться где угодно в Нижнем мире. В ее сундуках могут храниться незеритовые слитки и шаблоны улучшения."
  ],
  "quest.319428452110100A.quest_desc": [
    "Мегакорабли Моуга дрейфуют по внешнему Энду с капитаном скелетом-исушителем на борту.",
    "",
    "Они переносят элитры в рамках для предметов, так что это второй источник элитр помимо городов Энда."
  ],
  "quest.6EFD9C957BD47563.title": "&bКлюч могильщика",
  "quest.120E37CE2AB140FA.title": "&cИнфернальный алтарь",
  "quest.7063420D36849583.quest_desc": [
    "Острова сирен возвышаются над открытым океаном. Прислушайтесь к пению, прежде чем увидите их."
  ],
  "quest.120E37CE2AB140FA.quest_desc": [
    "Инфернальный алтарь стоит в Инфернальных дюнах. Бросьте на него звезду Нижнего мира, чтобы призвать его стража."
  ],
  "quest.269CA7E3614C0826.title": "&cМорские змеи",
  "quest.6A7DB2334016638A.quest_desc": [
    "Взрослые драконы гнездятся на поверхности на куче сокровищ. Огненные драконы живут в пустынях и вулканических землях, ледяные — в заснеженных биомах, а электрические — в джунглях, бесплодных землях, саваннах и болотах.",
    "",
    "Огненные и ледяные драконы спят ночью, электрические — днем. Ваш первый удар будит их."
  ],
  "quest.1A235CAF42A6F6A0.quest_desc": [
    "Три биома Nullscape в пустоте.",
    "",
    "- &0Теневые земли&r: чернокамень и базальт с костяными деревьями.",
    "- &7Пустоши пустоты&r: голый эндерняк и почти ничего больше.",
    "- &bКристаллические пики&r: кристаллические образования."
  ],
  "quest.24D8E1226694FEED.quest_desc": [
    "&cЛеонард&r появляется из зелья в котле, для которого нужна шляпа ведьмы. У него 500 здоровья, он сражается в три фазы и сбрасывает урну Леонарда."
  ],
  "quest.502E257ED1246812.title": "&aПещера гидры",
  "quest.25975DB5C7ADE870.quest_desc": [
    "&cДревний страж&r охраняет каждый океанский храм и памятник. Его проклятие замедляет вашу добычу, поэтому убейте его, прежде чем начнете ломать стены."
  ],
  "quest.18DE042E91A96693.title": "&cСангвинический торговец",
  "quest.30C87E5D353137F6.title": "&aРогатая статуя",
  "quest.33D0A75727D9CB58.quest_desc": [
    "Усадьбы и мраморные шато содержат самые дорогие магазины в сборке.",
    "",
    "- &6Привратник&r: жемчужины врат, ключи испытаний и призыватель захватчиков Apothic.",
    "- &6Игрок&r: ящики с добычей от 25 до 750 монет. Он торгует только после того, как вы откроете собственный ящик с добычей.",
    "",
    "{@pagebreak}",
    "&bМеста:&r Усадьба, Мраморное шато (ATi)",
    "",
    "&dРазблокировка:&r ",
    "Привратник - Получить врата, ",
    "Игрок - Открыть ящик с добычей"
  ],
  "quest.6A7DB2334016638A.title": "&6Гнезда драконов",
  "quest.20393692539B1184.title": "&bЖуткий мавзолей",
  "quest.7F209ECB076B2B30.title": "&6Исследования",
  "quest.167F48E2584A3022.quest_desc": [
    "Дайте статуе покровителя хобгоблинов звезду Нижнего мира, и &cМог&r с &cГулгом&r появятся вместе, у каждого по 400 здоровья.",
    "",
    "Из них выпадают колчан Мога и пояс Гулга."
  ],
  "quest.7EE3B916522A9170.quest_desc": [
    "Храмы горгон стоят на пляжах. Горгона ждет в подвале, за люком, который открывается переключателем."
  ],
  "quest.2965565D68C9761B.title": "&3Древнее судно",
  "quest.2913824ED3340F93.quest_desc": [
    "Небольшие руины из темного призмарина усеивают дно океана, и каждая арка до сих пор удерживает работающий &aводный катализатор&r. Этот катализатор — ваш первый лазер, и именно так вы начинаете лазерное ремесло с &eNautec&r.",
    "",
    "Разломайте его и заберите домой. &aРжавый ящик&r рядом с ним хранит &2призмариновые лазерные реле&r и другие детали, но его замок заржавел. Опустите его в &2травильную кислоту&r, чтобы очистить, а затем откройте чистый &aящик&r, как сундук. Прочистка &aподозрительного гравия&r вокруг руин позволяет обнаружить те же детали."
  ],
  "quest.1FF99FC384C22A24.title": "&dВнутренний двор Эндкипа",
  "task.6BADEBBA351BFE5C.title": "Любой череп дракона",
  "quest.4E77F883F5F8C4E7.title": "&6Деревенские торговцы",
  "quest.6B87A87B53F85BD4.quest_desc": [
    "Лес из синих цветов с аметистами, растущими из земли."
  ],
  "quest.3395E39DF22F7E53.title": "&3Монумент Вардена",
  "quest.1D96D2FF800AE80A.quest_desc": [
    "Океанские храмы Моуга расположены на дне глубоких морей. В сокровищнице в одном случае из четырех находится сердце морей."
  ],
  "quest.7063420D36849583.title": "&aОстров сирен",
  "quest.46EEC36A2FA7A0D0.quest_desc": [
    "Острова заколдованных деревьев и гигантских грибов далеко в открытом океане."
  ],
  "quest.25975DB5C7ADE870.title": "&cДревний страж",
  "quest.6B9AD6056DC2E540.title": "&aПещера циклопа",
  "quest.124F536BB57E1365.title": "&cСирены",
  "quest.55B3900E2E519129.title": "&9Лихой рубака",
  "quest.40892A92CA977BA0.title": "&cВулканические пики",
  "quest.5A03706C37C733CE.quest_desc": [
    "Башни магов и комплексы магов Terralith являются домом для &dчародея&r.",
    "",
    "Ассортимент: реагенты и руны Ars Magica, одежда мага и фолианты сродства, а также несколько предметов сердец от Baubley Heart Canisters.",
    "{@pagebreak}",
    "&bМеста:&r Башня магов, Комплекс магов (Terralith)",
    "",
    "&dРазблокировка:&r Получите винтеумовую пыль"
  ],
  "quest.3395E39DF22F7E53.quest_desc": [
    "Монумент Вардена стоит в глубокой тьме или на замерзших пиках, а внутри уже находится Варден.",
    "",
    "Его семь сундуков используют добычу из древнего города, а этот Варден сбрасывает ключ от подземелья, как и любой другой."
  ],
  "quest.319428452110100A.title": "&dМегакорабли",
  "quest.73127D9218A217CB.quest_desc": [
    "У &cгидры&r 550 здоровья. Каждая срубленная голова вырастает обратно в виде двух, вплоть до девяти, и она исцеляется, если не горит.",
    "",
    "Поджгите ее и поддерживайте огонь."
  ],
  "task.52CD1A19C7C03226.title": "Посетить любой биом Небесных земель"
}
