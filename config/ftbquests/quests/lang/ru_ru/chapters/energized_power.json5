{
  "quest.5F6D849BF0735415.quest_desc": [
    "Батареи в кармане, аккумуляторные блоки на стене.",
    "",
    "Создайте &aАккумуляторный блок&r из четырёх батарей V. Он хранит 65 536 FE и передаёт 2 048 FE за такт, а улучшенный и элитный блоки вмещают 8 388 608 и 268 435 456 FE.",
  ],
  "quest.2418AC7F8E4D0437.title": "Электрическая печь",
  "quest.0004A2325D5DE642.title": "Сборочный автомат",
  "quest.45AEC6C17B2D353C.quest_desc": [
    "Грязную воду определённо стоит сохранять.",
    "",
    "Постройте &aФильтровальную установку&r и подавайте в неё грязную воду и &2угольные фильтры&r. Каждые 100 мБ с вероятностью 33% дают камешек и с меньшей вероятностью — необработанную руду, причём в этой сборке в её список добавлено 19 металлов.",
  ],
  "quest.6CD01296F218E3A9.title": "Модули улучшений",
  "quest.4314E0DEC99B8C9C.quest_desc": [
    "Экспресс-конвейеры перемещают предметы каждые 2 такта.",
    "",
    "Создайте комплект &aэкспресс-конвейерных лент&r: ленту, загрузчик и сортировщик.",
  ],
  "quest.5C58946645097EBF.title": "Кристаллизованный лазурит",
  "quest.39454A3309E666EA.quest_desc": [
    "Элитные механизмы — это последний уровень в каждой линейке машин.",
    "",
    "Постройте &aЭлитную электрическую печь&r и &2Элитный автосборщик&r. Печь плавит сразу семь стаков за одну двадцатую от ванильного времени.",
  ],
  "quest.39454A3309E666EA.title": "Элитные механизмы",
  "quest.0D6C804C2A6E9ECE.title": "Пресс для металла",
  "quest.537D4A1C121F9114.quest_desc": [
    "Самый большой аккумуляторный блок.",
    "",
    "Создайте &aЭлитный аккумуляторный блок&r из четырёх батарей X. Он вмещает 268 435 456 FE и передаёт 16 777 216 FE за такт.",
  ],
  "quest.5FE464F00FF65F8E.quest_desc": [
    "Опыт можно хранить в виде жидкости.",
    "",
    "Постройте &aСлив опыта&r над &2Крошечным хранилищем опыта&r. Слив вытягивает опыт у стоящих на нём игроков и из сфер опыта поблизости, сохраняя его внизу.",
  ],
  "quest.61B9CB144078F595.title": "Телепорт",
  "quest.535CC5C59EEBAEF1.quest_desc": [
    "Жидкостям нужна собственная сеть.",
    "",
    "Создайте &aМедную жидкостную трубу&r и &2Малый резервуар для жидкости&r. Медная труба передаёт 100 мБ за такт с каждой извлекающей стороны, стальная — 2 500, а труба под давлением — 10 000. Настройте извлекающие стороны с помощью &2Гаечного ключа&r.",
    "",
    "Малый резервуар вмещает 8 вёдер, средний — 32, а большой — 128.",
  ],
  "quest.45AEC6C17B2D353C.title": "Фильтровальная установка",
  "quest.41381654B022CD0D.quest_desc": [
    "Два небольших механизма для нестандартных задач.",
    "",
    "Постройте &aУстановщик блоков&r и &2Автокамнерез&r. Установщик ставит любой блок, даже двери и семена, а автокамнерез выполняет рецепты камнереза, если внутрь положить кирку.",
  ],
  "quest.22059B7A059A6295.title": "Лесопилка",
  "quest.694B3717341A77D5.title": "Сверхпроводник",
  "quest.6F21487103C2B864.quest_desc": [
    "Два инструмента для понимания работы механизмов.",
    "",
    "Создайте &aАнализатор энергии&r и &2Конфигуратор механизмов&r. Анализатор показывает накопленную в блоке энергию, а конфигуратор копирует настройки сторон и редстоуна с одного механизма на другой.",
  ],
  "quest.61FB33A5F7FACDB9.title": "Дробление и измельчение",
  "quest.22059B7A059A6295.quest_desc": [
    "Пила позволяет извлечь из древесины больше пользы.",
    "",
    "Постройте &aЛесопилку&r. Одно бревно превращается в 6 досок и кучку опилок; кроме того, она разбирает деревянные предметы обратно.",
  ],
  "quest.254F71CE27B713D8.quest_desc": [
    "Четвёртый корпус открывает механизмы, меняющие окружающий мир.",
    "",
    "Создайте &aУкреплённый улучшенный корпус механизма&r из улучшенного корпуса, четырёх заряженных кристаллических матриц и четырёх блоков кремния.",
  ],
  "quest.4726F0EF568479F8.quest_desc": [
    "Второй корпус открывает работу с жидкостями и сборку.",
    "",
    "Создайте &aЗакалённый корпус механизма&r из базового корпуса, железных шестерней, железных стержней, кремния и стали. Он открывает жидкостные механизмы, термальный генератор и сборочный автомат.",
  ],
  "quest.7F452738E6DA6DE2.quest_desc": [
    "Гроза — это уйма бесплатной энергии, если удастся её поймать.",
    "",
    "Установите &2Громоотвод&r поверх &aГенератора молний&r. Каждый удар сохраняет 1 000 000 FE, а отдаёт генератор до 65 536 FE за такт.",
    "",
    "Контроллер погоды, настроенный на грозу, вызывает штормы, порождающие молнии.",
  ],
  "quest.5F6D849BF0735415.title": "Аккумуляторный блок",
  "quest.39CF1A9F34B62EDD.quest_desc": [
    "Улучшенный сплав в этой сборке — это сплав из &eFTB Industrial Contraptions&r.",
    "",
    "Создайте &aУлучшенный сплав&r в &2Печи для сплавов&r или индукционной плавильне из одного стального и одного алюминиевого слитка плюс два бронзовых, одного электрумового или двух инваровых.",
  ],
  "quest.6AD61318102E2CEE.title": "Элитные улучшения",
  "quest.2418AC7F8E4D0437.quest_desc": [
    "Ваш первый механизм должен заменить печь.",
    "",
    "Постройте &aЭлектрическую печь&r. Она плавит вдвое быстрее ванильной печи, расходуя 2 FE за такт, а &2Модуль улучшения плавильни&r или &aМодуль улучшения коптильни&r переключают её на соответствующий тип рецептов.",
  ],
  "quest.4314E0DEC99B8C9C.title": "Экспресс-конвейеры",
  "quest.24394380B59A3DA0.quest_desc": [
    "Энергия, которая не сохранена, тратится впустую.",
    "",
    "Постройте &aЗарядник&r и дойдите до &2Батареи V&r. Каждый уровень батарей создаётся из предыдущего, а &2Разрядник&r опустошает их обратно в сеть.",
  ],
  "quest.4C97C7EB355F1A8C.quest_desc": [
    "У каждого базового механизма есть более быстрая версия.",
    "",
    "Постройте &aУлучшенную электрическую печь&r, &2Улучшенный пульверизатор&r и Улучшенный дробитель. Пульверизатор и дробитель работают в четыре раза быстрее, расходуют по 10 мБ воды на рецепт и производят &2Грязную воду&r.",
  ],
  "quest.6A59069E389CBA24.title": "Камера выращивания кристаллов",
  "quest.4AD16D2958B25FFB.title": "Автосборщик",
  "quest.5A08FA1A20258BB2.quest_desc": [
    "Пропускайте ночь без кровати.",
    "",
    "Постройте &aКонтроллер времени&r. Он устанавливает время на день, полдень, ночь или полночь за 8 388 608 FE за раз, причём время движется только вперёд.",
  ],
  "quest.5A08FA1A20258BB2.title": "Контроллер времени",
  "quest.1B51F2E8350A3145.quest_desc": [
    "Блоки мода настраиваются одним инструментом.",
    "",
    "Создайте &aГаечный ключ&r. Он настраивает извлекающие стороны труб, наклон конвейерной ленты и стороны настраиваемого трансформатора.",
  ],
  "quest.41381654B022CD0D.title": "Установщики и камнерезы",
  "quest.4AD16D2958B25FFB.quest_desc": [
    "Ручной крафт быстро перестаёт справляться с объёмами.",
    "",
    "Постройте &aАвтосборщик&r. Задайте ему шаблон крафта, и он будет создавать предметы по мере поступления ингредиентов. Улучшенный автосборщик обрабатывает несколько рецептов сразу, а элитный крафтит ещё быстрее.",
  ],
  "quest.694B3717341A77D5.quest_desc": [
    "Финальный кабель требует проводника в постоянном охлаждении.",
    "",
    "Соберите &aОхлаждающие ячейки&r, а затем &2Сверхпроводники&r из охлаждающих ячеек, кристаллизованного лазурита, пластин заряженного сплава и заряженной золотой проволоки.",
  ],
  "quest.11EABC139262D289.quest_desc": [
    "Массовое хранилище для предметов одного вида.",
    "",
    "Постройте &aКрошечный бункер для предметов&r. Он вмещает 50 стаков одного предмета и может заполняться и опустошаться только воронками, конвейерами и другой автоматизацией; гигантский бункер вмещает 1 000 стаков.",
  ],
  "quest.65A01F46F7044328.quest_desc": [
    "Каждый механизм в моде строится на основе корпуса, и &aБазовый корпус механизма&r — первый из них.",
    "",
    "Создайте &aБазовый корпус механизма&r. В этой сборке в центр кладётся &2Стальной слиток&r, который &aПечь для сплавов&r делает из одного железного слитка и одного угля.",
    "",
    "Базовый корпус механизма также служит рабочим блоком &dЭлектрика&r, а электрики продают изоляторы кабелей, батареи, кабели и некоторые начальные механизмы.",
  ],
  "quest.06701D04327780C6.quest_desc": [
    "Один сборщик — несколько рецептов.",
    "",
    "Постройте &aУлучшенный автосборщик&r. Он вмещает несколько шаблонов одновременно и крафтит вдвое быстрее базового.",
  ],
  "quest.537D4A1C121F9114.title": "Элитный аккумуляторный блок",
  "quest.5A559FF1147D2459.title": "Зарядная станция",
  "quest.454517F5F0917F46.title": "Солнечные панели",
  "quest.65A01F46F7044328.title": "Базовый корпус механизма",
  "quest.1B95E11A97F6D2C6.title": "Термальный генератор",
  "quest.196DBB74F9A47B69.quest_desc": [
    "&eEnergized Power&r — это полноценная технологическая ветка: от генераторов, кабелей и обрабатывающих механизмов до устройств перемещения игроков и управления погодой.",
    "",
    "Продвигайтесь по корпусам механизмов слева направо. Каждый новый корпус открывает следующий набор механизмов, а квесты над и под каждым корпусом представляют открываемые им машины.",
    "",
    "&eПримечание&r: эта сборка в некоторых местах меняет мод. Угольный двигатель удалён, сталь используется уже в первом корпусе, а многие пластины, провода и пыли берутся из &eFTB Materials&r.",
  ],
  "quest.0004A2325D5DE642.quest_desc": [
    "Микросхемы выше базовой не создаются на верстаке, а собираются.",
    "",
    "Постройте &aСборочный автомат&r. Он производит улучшенные микросхемы, процессоры, солнечные элементы и кристаллическую матрицу, которая понадобится для более поздних корпусов.",
  ],
  "quest.3C141E8FE709BDF2.title": "Контроллер погоды",
  "quest.64D5A4564AB0C180.title": "Индукционная плавильня",
  "quest.2A868E9D86980F2C.quest_desc": [
    "Мод сам предоставляет своё руководство.",
    "",
    "Создайте &aКнигу Energized Power&r. Кликните левой кнопкой мыши по любому блоку мода с книгой в руке, чтобы открыть страницу этого блока.",
    "",
    "&eПримечание&r: на некоторых страницах описаны вещи, изменённые сборкой, например, угольный двигатель и переплавка кварца в кремний.",
  ],
  "quest.3F44E3225E41C7CF.title": "Элитный корпус механизма",
  "quest.5C58946645097EBF.quest_desc": [
    "Кристаллизованный лазурит растёт медленно.",
    "",
    "Выращивайте &aКристаллизованный лазурит&r в камере выращивания кристаллов. Из восьми лазуритов получается один кристалл за 128 000 тактов — более пяти внутриигровых дней без улучшений, однако один кристалл вырастает в большее количество уже за 32 000 тактов, так что сохраните первый.",
    "",
    "&eПримечание&r: подсказка рекомендует установить в камеру два комплекта улучшений VI уровня перед началом работы.",
  ],
  "quest.3F44E3225E41C7CF.quest_desc": [
    "Дорогостоящий сплав идёт на топовый корпус.",
    "",
    "Сплавьте кристаллизованный лазурит, кристаллическую матрицу и улучшенный сплав в &2Кристаллизованный сплав&r, а затем зарядите его в &aЗаряженный сплав&r за 8 388 608 FE. Соберите из них &aЭлитный корпус механизма&r.",
    "",
    "&eПримечание&r: для заряжателя требуется модуль улучшения энергоёмкости IV или выше, чтобы вместить достаточно энергии для заряженного сплава.",
  ],
  "quest.5A559FF1147D2459.quest_desc": [
    "Хватит доставать инструменты, чтобы зарядить их.",
    "",
    "Постройте &aЗарядную станцию&r. Она заряжает предметы всех игроков в радиусе 7 блоков, а модули улучшения дальности расширяют эту зону.",
  ],
  "quest.6AD61318102E2CEE.quest_desc": [
    "Уровни улучшений VII и VIII устанавливаются на элитный модуль.",
    "",
    "Создайте &aЭлитный модуль улучшения&r. Улучшение скорости VIII ускоряет механизм в 40 раз при 80-кратном расходе энергии, а улучшение энергоёмкости VIII увеличивает ёмкость и скорость передачи в 80 раз.",
  ],
  "quest.39CF1A9F34B62EDD.title": "Улучшенный сплав",
  "quest.52A6CCD14E5E5144.quest_desc": [
    "Поскольку угольного двигателя нет, начальная энергия вырабатывается из лавы или солнечных панелей.",
    "",
    "Постройте &aТепловой генератор&r и разместите лаву вплотную к его граням. Каждый источник неподвижной лавы, касающийся его, даёт 25 FE за такт, а текущая лава — 15 FE за такт, вплоть до 150 FE за такт при лаве со всех шести сторон.",
  ],
  "quest.3CAB8C8CA70E31C9.title": "Камера выращивания растений",
  "quest.7F452738E6DA6DE2.title": "Генератор молний",
  "quest.254F71CE27B713D8.title": "Укреплённый улучшенный корпус",
  "quest.2CE134BC4AFE943F.quest_desc": [
    "Базовые конвейерные ленты перемещают предмет на один шаг каждые 10 тактов.",
    "",
    "Создайте &aБыструю конвейерную ленту&r, которая делает шаг каждые 6 тактов.",
  ],
  "quest.6F21487103C2B864.title": "Анализаторы и конфигуратор",
  "quest.2D9A1A4DBC4D54BC.title": "Камень и вода",
  "quest.61B9CB144078F595.quest_desc": [
    "Ходить пешком приходится тем, у кого нет лишних 8 миллионов FE.",
    "",
    "Постройте два &aТелепорта&r и &2Матрицу телепорта&r. Нажмите Shift + ПКМ матрицей по целевому телепорту, чтобы привязать её, вставьте матрицу в другой телепорт, затем встаньте на него и активируйте редстоуном или горячей клавишей телепортации.",
    "",
    "Каждый прыжок расходует весь буфер в 8 388 608 FE и работает между измерениями.",
  ],
  "quest.2CC87ECDB76CCBD1.quest_desc": [
    "С третьим корпусом возможности мода становятся по-настоящему быстрыми.",
    "",
    "Создайте &aУлучшенный корпус механизма&r из закалённого корпуса, двух слитков улучшенного сплава, кремния и четырёх латунных слитков.",
  ],
  "quest.0D6C804C2A6E9ECE.quest_desc": [
    "Пресс-формам нужен пресс.",
    "",
    "Постройте &aПресс для металла&r. С установленной формой он прессует пластины в провода, стержни или шестерни, причём каждое прессование немного изнашивает форму.",
    "",
    "Пластины изготавливаются в &2Компрессоре&r.",
  ],
  "quest.627553EDEFCE9C01.quest_desc": [
    "Шестерни и стержни здесь не делаются в сетке верстака.",
    "",
    "Постройте &aФормовщик пресс-форм&r, придайте глине форму заготовок и обожгите их. &aПресс-форма для шестерней&r и &2Пресс-форма для стержней&r позволят прессу для металла изготавливать железные шестерни и стержни, необходимые для следующего корпуса.",
    "",
    "Базовые формы выдерживают 2 000 прессований. Закалённые, улучшенные и элитные формы служат намного дольше.",
  ],
  "quest.5D5E354DBE1226B7.title": "Кристаллическая матрица",
  "quest.763CFE19384B50BF.quest_desc": [
    "Турбо-конвейеры перемещают предмет каждый такт.",
    "",
    "Создайте &aТурбо-конвейерную ленту&r. Для неё требуется кристаллизованный сплав, поэтому она появляется на поздних этапах.",
  ],
  "quest.454517F5F0917F46.quest_desc": [
    "Солнечным панелям нужны только открытое небо и дневной свет.",
    "",
    "Создайте &aСолнечные панели&r вплоть до III уровня. Каждый уровень строится на основе предыдущего, а в этой сборке их пиковая выработка от I до VII уровня составляет 2, 16, 64, 256, 512, 4 096 и 16 000 FE за такт.",
    "",
    "&eПримечание&r: модули улучшения лунного света позволяют им продолжать работать ночью.",
  ],
  "quest.1B95E11A97F6D2C6.quest_desc": [
    "Подавайте лаву по трубам вместо того, чтобы разливать её вокруг генератора.",
    "",
    "Постройте &aТермальный генератор&r и подавайте в него лаву. В этой сборке ведро лавы даёт 10 000 FE и сгорает со скоростью до 500 FE за такт.",
  ],
  "quest.5A1884B152041DF2.title": "Конвейерные ленты",
  "quest.52A6CCD14E5E5144.title": "Тепловой генератор",
  "quest.196DBB74F9A47B69.title": "Energized Power",
  "quest.535CC5C59EEBAEF1.title": "Трубы и резервуары",
  "quest.5A1884B152041DF2.quest_desc": [
    "Конвейерные ленты перемещают предметы без труб и наглядно показывают всё, что на них находится.",
    "",
    "Создайте &aКонвейерную ленту&r, &2Загрузчик конвейера&r и Сортировщик конвейера. Загрузчик перемещает предметы из инвентаря на ленту, ленты выгружают предметы в блок перед собой, а сортировщик направляет предметы влево, прямо или вправо по фильтру.",
    "",
    "Разветвители, объединители и переключатели дополняют каждый уровень лент.",
  ],
  "quest.6CD01296F218E3A9.quest_desc": [
    "Большинство механизмов поддерживают улучшения, и самые дешёвые из них полезны уже на раннем этапе.",
    "",
    "Создайте &aБазовый модуль улучшения&r и превратите его в &2Модуль улучшения скорости I&r. Скорость I делает механизм в 1.2 раза быстрее при 1.4-кратном расходе энергии; модули энергоэффективности, энергоёмкости, выталкивания и затягивания предметов работают аналогичным образом.",
    "",
    "Улучшения вставляются во вкладку улучшений механизма вручную. Более высокие уровни строятся на улучшенных, укреплённых и элитных модулях.",
  ],
  "quest.06701D04327780C6.title": "Улучшенный автосборщик",
  "quest.2CE134BC4AFE943F.title": "Быстрые конвейеры",
  "quest.5FE464F00FF65F8E.title": "Жидкий опыт",
  "quest.2CC87ECDB76CCBD1.title": "Улучшенный корпус механизма",
  "quest.3C141E8FE709BDF2.quest_desc": [
    "Дождь по требованию или ясное небо навсегда.",
    "",
    "Постройте &aКонтроллер погоды&r. Он устанавливает ясную погоду, дождь или грозу, и каждое переключение опустошает его буфер в 8 388 608 FE. Модули улучшения длительности продлевают эффект, а длительность VI поддерживает погоду до тех пор, пока контроллер получает питание.",
  ],
  "quest.2D9A1A4DBC4D54BC.quest_desc": [
    "Вода и лава превращаются в блоки, а блоки — обратно в жидкости.",
    "",
    "Постройте &aЗатвердитель камня&r, &2Сжижитель камня&r и Замораживатель жидкостей. Затвердитель создаёт булыжник, камень и обсидиан из воды и лавы, сжижитель плавит камень в лаву, а замораживатель превращает воду в лёд и снег.",
  ],
  "quest.2A868E9D86980F2C.title": "Книга Energized Power",
  "quest.6A59069E389CBA24.quest_desc": [
    "Некоторые материалы можно только вырастить.",
    "",
    "Постройте &aКамеру выращивания кристаллов&r. Она выращивает осколки аметиста, цветущий аметист и кристаллизованный лазурит, а в этой сборке — также осколки и цветущие блоки для самоцветов &eGeOre&r.",
    "",
    "Она потребляет 1 024 FE за такт, а её рецепты занимают от 16 000 до 128 000 тактов, поэтому снабдите её улучшениями скорости как можно раньше.",
  ],
  "quest.763CFE19384B50BF.title": "Турбо-конвейеры",
  "quest.24394380B59A3DA0.title": "Зарядка и аккумуляторы",
  "quest.11EABC139262D289.title": "Бункеры для предметов",
  "quest.5D5E354DBE1226B7.quest_desc": [
    "Следующий корпус строится на заряженном кристалле.",
    "",
    "Соберите &aКристаллическую матрицу&r из аметиста, алмазов, изумрудов и редстоунового сплава, а затем зарядите её в &2Заряженную кристаллическую матрицу&r за 524 288 FE.",
  ],
  "quest.627553EDEFCE9C01.title": "Пресс-формы",
  "quest.4726F0EF568479F8.title": "Закалённый корпус механизма",
  "quest.2D1B85CD83A93F5E.title": "Сверхпроводящий кабель",
  "quest.4C97C7EB355F1A8C.title": "Продвинутая обработка",
  "quest.3CAB8C8CA70E31C9.quest_desc": [
    "Фермам больше не нужны открытые поля.",
    "",
    "Постройте &aКамеру выращивания растений&r. Положите семя в слот для семян и блок почвы в слот для почвы, и она будет выращивать урожай на воде и энергии.",
    "",
    "Почва задаёт скорость: пашня ускоряет рост в 1.5 раза при меньших затратах энергии, грязь расходует вдвое меньше воды, а мицелий удваивает скорость роста грибов. Удобрение в третьем слоте ускоряет процесс ещё сильнее, но ценой повышенного расхода энергии.",
  ],
  "quest.64D5A4564AB0C180.quest_desc": [
    "Печь для сплавов сжигает топливо. &aИндукционная плавильня&r выполняет те же рецепты сплавов на энергии.",
    "",
    "Постройте &aИндукционную плавильню&r. Она изготавливает сплавы вдвое быстрее, расходуя 64 FE за такт.",
  ],
  "quest.2D1B85CD83A93F5E.quest_desc": [
    "Даже кабель из заряженной кристаллической матрицы ограничен 2 097 152 FE за такт.",
    "",
    "Создайте &aСверхпроводящий кабель&r. Он передаёт 16 777 216 FE за такт — больше любого другого кабеля в моде, и, как и любой кабель, подключается к кабелям других уровней только через трансформатор.",
  ],
  "quest.1B51F2E8350A3145.title": "Гаечный ключ",
  "quest.61FB33A5F7FACDB9.quest_desc": [
    "Два механизма измельчают материалы, но выполняют разные задачи.",
    "",
    "Постройте &aПульверизатор&r и &2Дробитель&r. Пульверизатор перемалывает руды и слитки в пыль с шансом получения дополнительной добычи, а дробитель последовательно измельчает камень в булыжник, гравий и песок.",
    "",
    "Оба работают на 8 FE за такт. Их улучшенные версии становятся доступны вместе с улучшенным корпусом.",
  ],
}