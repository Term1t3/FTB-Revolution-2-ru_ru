{
  "quest.7A14E14A72F0C88F.title": "&2Наживка",
  "quest.29C505C5D1927614.title": "&cМгновенное исцеление",
  "task.0530149F4E3FF764.title": "Кухонные шкафчики",
  "quest.6F6671705176E2F8.title": "&cРедстоуновая пыль",
  "task.0637AC7B02D2E783.title": "Любой деревянный или терракотовый &aплантер&r",
  "quest.47C84A22986E6A81.title": "&fТостер и кофемашина",
  "quest.53C1013488EFFDED.title": "&2Ловушка для животных",
  "quest.67647369B6065EEC.title": "&fНагревательный модуль",
  "quest.4DE0274AAFD9BF94.title": "&6Сушка и дробление",
  "quest.6E5692E47F7A4283.title": "&2Колпаки для плантеров",
  "quest.23FFD172C3555282.title": "&fПромышленная кулинария",
  "quest.154E08BC9091684F.quest_desc": [
    "&aСветопыль&r используется в качестве усилителя эффектов зелий.",
    "",
    "При добавлении она обычно увеличивает уровень (силу) зелья.",
  ],
  "quest.19DB27ECAB774058.quest_desc": [
    "Следите за поплавком и подсекайте в нужный момент. Но это лишь начало: как только рыба на крючке, она начинает бороться.",
    "",
    "Вываживание рыбы требует попадания по её &aактивным зонам (sweetspots)&r по мере их появления, и все они разные:",
    "",
    "- &fБазовая&r: стандартная зона, даёт прямой прогресс.",
    "- &7Каменная&r: почти не даёт никакого прогресса.",
    "- &bЛедяная&r: полностью избегайте её.",
    "- &7Глубинносланцевая&r: исчезает, если вы слишком медлительны.",
    "- &6Золотая&r: даёт прогресс поимки сокровища, а не рыбы.",
    "",
    "&aРазные виды рыб сопротивляются по-разному&r, так что знание того, кого вы подсекли — это уже полдела. Руководство подскажет вам это ещё до заброса.",
    "",
    "В настройках руководства есть режим тренировки, если вы хотите попрактиковаться без риска упустить улов.",
  ],
  "quest.53C1013488EFFDED.quest_desc": [
    "Для &aAnimal Trap&r нужна наживка, и именно наживка определяет, кого она поймает. Семена пшеницы привлекают курицу, а морковь — свинью. Остальное перечислено во вкладке Trapping в JEI.",
    "",
    "После небольшого ожидания ловушка делает проверку с &aшансом 5% каждую секунду&r. Пойманное животное остаётся в ловушке и приносит свой дроп каждые две с половиной минуты, пока внутри есть наживка, при этом каждый дроп с шансом 10% расходует одну наживку.",
    "",
    "&aЗатопите её водой&r и положите ламинарию в качестве наживки в реке или океане, и вместо этого она будет ловить лосося.",
  ],
  "quest.67647369B6065EEC.quest_desc": [
    "Установите &cHeating Upgrade&r в плиту (Stove), чтобы готовить блюда на энергии вместо угля!",
  ],
  "quest.487F2399A124C3E8.quest_desc": [
    "Пастбище, полное коров — это слишком много сущностей для игры. &aAnimal Pen&r позволяет содержать целое стадо в одном блоке.",
    "",
    "Нажмите ПКМ клеткой &aAnimal Cage&r по неприрученному взрослому животному, чтобы поймать его, затем нажмите ПКМ клеткой по загону, чтобы поместить его внутрь. Нажмите Shift + ПКМ по загону пустой клеткой, чтобы забрать половину животных обратно.",
    "{@pagebreak}",
    "Кормите загон привычной для животного пищей для размножения, чтобы увеличить стадо вплоть до &a24&r особей. Ведро собирает молоко у коров и яйца у кур, ножницы стригут шерсть с овец, а меч или топор забивают животных ради дропа.",
    "",
    "Загоны также взаимодействуют с компараторами и раздатчиками, так что дойку и стрижку можно автоматизировать.",
  ],
  "quest.3AAE0A3262894C43.quest_desc": [
    "&aКонденсаторы (Capacitors)&r хранят &cRF&r, вырабатываемую вашими горелками, и раздают её всем устройствам поблизости.",
    "",
    "Они не требуют никакой настройки. Они автоматически балансируют заряд между собой, так что вы можете просто поставить несколько штук вокруг фермы и забыть о них.",
    "",
    "Всего доступно три уровня, каждый из которых вмещает больше энергии и передаёт её быстрее предыдущего.",
  ],
  "quest.18DEFD2E007D08AA.title": "&2Сады и кустарники",
  "quest.11C072E618300154.title": "&6Рыбалка за сокровищами",
  "quest.186BE7F6DFA8C41E.quest_desc": [
    "&3Порох&r превращает зелья во &aВзрывные зелья (Splash Potions)&r.",
    "",
    "Такие зелья бросаются для создания эффекта по площади вместо обычного питья.",
  ],
  "quest.586A4F3BBC9F7275.title": "&fМоллюски и жемчужины",
  "quest.46223192C9DD4975.title": "&fСоединители и куриные раковины",
  "quest.5D2D114B66DE61EE.title": "&bБесконечный источник воды?",
  "quest.10AB0C0930A5D77D.title": "&5Регенерация",
  "quest.4498067DF133EEFD.title": "&aВольеры (Aviaries)",
  "quest.0F15A94920C420AC.title": "&6Генератор на конной тяге",
  "quest.3A389EDA045B65E1.quest_desc": [
    "Морковь можно найти на деревенских грядках или выбить из случайного зомби. Одной штуки достаточно, чтобы завести собственный огород.",
    "",
    "Она растёт на вспаханной, увлажнённой пашне и требует света, как и любая культура. Пересаживайте часть собранного урожая, и грядка окупит себя за одну ночь.",
  ],
  "quest.3257746A213CB9B7.title": "&6Турниры и трофеи",
  "quest.42B3EE6283C80A80.quest_desc": [
    "&aHorse Press&r выжимает семена в &2Seed Oil&r (масло семян). Он также выжимает цветы в красители и лёд в воду, а остальные рецепты указаны во вкладке Horse Pressing в JEI.",
    "",
    "Масло семян — отличное топливо для печи: одного ведра хватает на переплавку 80 предметов. Это превращает излишки семян с любой фермы в ценный ресурс.",
    "",
    "Оно хранится и перекачивается как жидкость, поэтому вам понадобится ведро или резервуар.",
  ],
  "quest.287E6819DB849CD4.quest_desc": [
    "&aTool Rack&r — идеальное место для хранения и быстрого доступа к вашим кухонным принадлежностям.",
    "",
    "К тому же с ней ваша кухня выглядит куда уютнее и реалистичнее!",
  ],
  "quest.10BE7DAF2BEAF714.title": "&fБанки для печенья и молока",
  "quest.3879EE0C19E79053.quest_desc": [
    "&aHorse Chopper&r — это версия разделочного блока на тяге животных. Он высотой в два блока, поэтому над местом его установки требуется один свободный блок пространства.",
    "",
    "Он распиливает брёвна на доски и превращает некоторые деревянные предметы обратно в палки гораздо быстрее, чем вручную.",
    "",
    "Животное ходит по кругу размером 7 на 7 блоков вокруг механизма. Внутри этого кольца допускается не более двух твёрдых блоков (например, сундуков или воронок), поэтому держите путь свободным.",
  ],
  "quest.6D8485CEF00C0B60.quest_desc": [
    "Четырнадцать новых культур, каждая со своими семенами: от &aкукурузы (Corn)&r и цветной капусты до риса, сои и клубники. Все они перечислены в JEI.",
    "",
    "Первые семена можно найти в сундуках с добычей, купить на фермерском &aрынке (Market)&r или у странствующего торговца. После этого пресс Artisan Press позволит превращать урожай обратно в семена.",
    "",
    "Они растут на обычной пашне. У плантеров Agritech нет для них рецептов, поэтому сажайте их прямо в землю.",
  ],
  "quest.42B3EE6283C80A80.title": "&6Пресс на конной тяге",
  "quest.0F15A94920C420AC.quest_desc": [
    "Мостик ко всем остальным технологиям в этой сборке — это генератор, работающий от &aходящего по кругу животного&r.",
    "",
    "Он вырабатывает 80 FE/t, причём только при наличии сигнала редстоуна, так что установите на него рычаг. Он никогда не сравнится с реактором, но обеспечит работу ваших первых машин задолго до появления других способов добычи энергии.",
    "",
    "&7&oЕсли вы начинаете новый мир, это по-настоящему рабочий первый источник энергии.&r",
  ],
  "quest.1E0BB50868F951A3.title": "&fКорзина для фруктов",
  "quest.514E3A822BFB730B.title": "&fБесплатное молоко!",
  "quest.553EE7D5FF66C61D.title": "&6Ящик для снастей (Tackle Box)",
  "quest.2EA7CCDB687AC468.quest_desc": [
    "&aPreservation Upgrade&r всегда сохраняет как минимум 1 предмет из стопки от расходования в кулинарных рецептах.",
  ],
  "task.3B7699715021E7F7.title": "Устанавливаемая еда",
  "quest.6B7CE7931C91B128.title": "&2Распылители и силосы",
  "quest.3A11543E54EFD7D9.title": "&2Биомасса и энергия",
  "quest.709DACF3C4655662.title": "&fКладовая",
  "quest.553EE7D5FF66C61D.quest_desc": [
    "В ящике для снастей (&aTackle Box&r) хранится ваш улов и рыболовное снаряжение, и это единственное место, где можно менять оснастку вашей удочки.",
    "",
    "Три слота модификаторов, каждый из которых меняет процесс рыбалки:",
    "",
    "- &aКрючки (Hooks)&r: железный, каменный, медный (все стадии окисления), золотой, аметистовый, ледяной, эхо-крючок, тяжёлый, замшелый, ржавый, блестящий, сдвоенный и классический ванильный.",
    "- &2Поплавки (Bobbers)&r: обычный, устойчивый, прозрачный, лиственный, слизневый, капельниковый, светящийся, золотой, облачный и ванильный.",
    "- &aНаживки (Baits)&r: см. следующий квест.",
    "",
    "Шляпы рыбака (Fisherman's Hats) также дают модификаторы и изредка встречаются в сундуках затонувших кораблей.",
  ],
  "quest.2EA7CCDB687AC468.title": "&fМодуль сохранения",
  "quest.73846333D68F6339.title": "&fФерма картофеля",
  "quest.52F610F471E53EFB.title": "&2Улучшенный плантер",
  "quest.487F2399A124C3E8.title": "&aЗагоны для животных",
  "quest.7B3B55130DE2D019.title": "&6Пресс ремесленника (Artisan Press)",
  "quest.5D2D114B66DE61EE.quest_desc": [
    "Моете ли вы посуду или охлаждаете ядерные реакторы — кухонная раковина (&aKitchen Sink&r) обеспечивает простой доступ к бесконечному источнику воды.",
    "",
    "При подключении к &bкухонному мультиблоку&r она открывает доступ ко всем рецептам, требующим воду.",
  ],
  "quest.24E11CBBB6EC58D5.title": "&fОгненный порошок",
  "quest.3670FA7818A11284.quest_desc": [
    "В мире полно отличной еды, дающей полезные характеристики, но ничто не заменит преимуществ от &cзельеварения&r.",
    "",
    "Сначала вам придётся одолжить &cогненный стержень&r у ифрита или просто стащить зельеварку из местной небесной деревни.",
    "",
    "&7&oКто я такой, чтобы судить?",
  ],
  "quest.014A81275259E6AF.quest_desc": [
    "Первый настоящий механизм. Привяжите оседланное животное к жернову (&aHorse Grindstone&r), и он будет вращаться без вашего участия.",
    "",
    "Перемалывание даёт &aмуку (Flour)&r, из которой делается &2тесто (Dough)&r, а затем хлеб; кроме того, жернов может обрабатывать руды и другие материалы.",
    "",
    "Деревянная воронка (Wooden Hopper) загружает ресурсы, так что после настройки весь процесс может идти полностью автономно.",
  ],
  "quest.5DBBF2E8AEFB4149.title": "&6Pantry for Blockheads",
  "quest.02B468BF096A840A.title": "&aСвойства на &5эссенциевых культурах",
  "quest.19DB27ECAB774058.title": "&bМиниигра Sweetspot",
  "quest.73846333D68F6339.quest_desc": [
    "Та же история, что и с морковью: те же места для поиска первой штуки.",
    "",
    "Картофель лучше подходит для массового выращивания, поскольку его запекание — это задача для печи, а не сложный крафт, и печёный картофель отлично насыщает.",
  ],
  "quest.073546F80EDA632E.title": "&fФермерский &aрынок",
  "quest.15441C87BEDC510C.title": "&2Agritech Evolved",
  "quest.2545259D5B8A6139.title": "&2Другие культуры",
  "quest.186BE7F6DFA8C41E.title": "&7Порох",
  "quest.6E5692E47F7A4283.quest_desc": [
    "Колпак (&aCloche Dome&r) устанавливается поверх &2плантера&r и увеличивает как скорость роста, так и урожайность.",
    "",
    "Его эффект &aсуммируется&r с удобрениями и используемой почвой, поэтому плантер с &2Infused Farmland&r под колпаком и с подпиткой от распылителя — это максимум скорости, возможный в этом моде.",
    "",
    "Нажмите Shift + ПКМ пустой рукой, чтобы снять колпак.",
  ],
  "quest.3C972EE25114E1AE.title": "&6Horse Powered",
  "quest.4C50A70027F208BE.quest_desc": [
    "Не вся еда употребляется прямо из рук.",
    "",
    "Такие блюда, как &aторт (Cake)&r, сначала нужно поставить на поверхность, но зато они дают несколько кусочков для утоления голода!",
  ],
  "quest.79CC3BBEC8B16640.quest_desc": [
    "Холодильник (&aFridge&r) — идеальное место для хранения охлаждённых продуктов, и его можно улучшать, чтобы открыть больше рецептов для вашего &bкухонного мультиблока&r!",
  ],
  "quest.59BFB93E613911CD.quest_desc": [
    "Улучшение до &aнезерита&r на кузнечном столе позволяет удочке ловить рыбу в лаве. До этого момента &dаметистовый крючок (Amethyst Hook)&r выполняет ту же функцию на любой удочке.",
    "",
    "Остальные именные удочки (Bamboo, Boner, Humble, Naturalist, Sky, Obsidian, Iceborn, Magmaforged, Slimed, Sharktooth, Lush Glowberry и Azure Crystal) — это облики, а не улучшения. Каждая получается с помощью кузнечного шаблона &aSkin Smithing Template&r, и его применение меняет внешний вид удочки, сохраняя все установленные на неё компоненты.",
    "",
    "&7&oВсе виды из Незера клюют в лаве, как и некоторые обитатели лавовых озёр Верхнего мира.",
  ],
  "quest.7A14E14A72F0C88F.quest_desc": [
    "&aЧерви (Worms)&r — стартовая наживка, которую можно получить, &2удобряя костной мукой пашню&r, что делает их практически бесплатными.",
    "",
    "&aИспользуйте ведро как наживку&r, и вы выловите пойманную добычу прямо в ведре.",
    "",
    "Лишь немногие уловы требуют строго определённой наживки, и руководство отмечает их. Для &aголовы крипера&r нужна наживка из пороха (Gunpowder Bait), а для звезды Незера — череп визер-скелета.",
    "{@pagebreak}",
    "Большинство наживок сокращают время ожидания поклёвки, но некоторые обладают особыми свойствами:",
    "",
    "- &aAlmighty Worm&r: позволяет вылавливать определённых рыб живыми.",
    "- &2Seeking Worm&r: повышает вероятность поклёвки ещё не пойманных вами видов.",
    "- &aLegendary Bait&r: самое быстрое ожидание поклёвки среди всех наживок.",
    "- &2Meteorological Bait&r: рыба, клюющая только в определённое время суток или погоду, будет клевать независимо от условий.",
    "- &aТематические наживки&r: вишнёвая, капельниковая, пороховая, пышная, мраководная и скалковая наживки ускоряют поклёвку точно так же, как и червь.",
  ],
  "quest.72EAA9618A3E114D.title": "&5Уровневая почва для эссенций",
  "quest.31BD9A98AE5893B9.quest_desc": [
    "У каждого на кухне есть полочка со специями (&aSpice Rack&r).",
    "",
    "Если у вас её нет — что вообще творится на вашей кухне?",
  ],
  "quest.18DEFD2E007D08AA.quest_desc": [
    "Мод также добавляет растительность в мир: &aлимонные&r и &2персиковые&r деревья, кусты черники и виноградные лозы, генерирующиеся в подходящих биомах.",
    "",
    "Две полезные мелочи, о которых стоит знать:",
    "- &aКусты сладких ягод больше не замедляют и не наносят урон.&r",
    "- &2Переедание даёт эффект поглощения «Сытость» (Well Fed)&r от определённых видов пищи.",
    "",
    "Печенья с предсказаниями (Fortune Cookies) накладывают случайный эффект с перезарядкой, и в них можно прочитать три десятка различных предсказаний.",
  ],
  "quest.0800E48C01F45F46.title": "&fФерма сладких ягод",
  "quest.1A64C6CE416B7C5E.quest_desc": [
    "В этой сборке работают сразу три системы рыбалки, и они дополняют друг друга, а не конфликтуют.",
    "",
    "- &bStarcatcher&r заменяет добычу и добавляет механику борьбы в зонах sweetspot.",
    "- &3Счастливые зоны Nautec (Lucky Zones)&r — это участки воды, дающие дополнительный ролл добычи при забросе в них. &aПодходит любая удочка&r, включая Starcatcher's Rod.",
    "- &6Места для рыбалки Little Joys&r — это участки с пузырьками от совершенно другого мода, делающие примерно то же самое.",
    "{@pagebreak}",
    "У &aPrismatic Fishing Rod&r есть собственная миниигра подсечки, отдельная от зон Starcatcher. При каждой поклёвке случайно выбирается шкала тайминга, трёхкратное ритмичное нажатие или удержание. Лучше выбрать одну удочку и освоить её ритм, чем постоянно переключаться.",
    "",
    "Квест по счастливым зонам Nautec привязан к этой доске, чтобы вы могли прочесть его, не покидая главу.",
  ],
  "quest.10963E2F6AEC9B3B.title": "&2Модули улучшений",
  "quest.4B4358B6B25DC413.quest_desc": [
    "&eStarcatcher&r добавляет собственную рыбалку параллельно с ванильной. Обычная удочка по-прежнему ловит стандартный ванильный улов, а при первой поимке чего-либо вы также выловите удочку &aStarcatcher's Rod&r и справочник &2Starcatcher's Guide&r.",
    "",
    "Для всего нового контента понадобится &aStarcatcher's Rod&r. Более сотни видов рыб распределены по биомам, измерениям и погодным условиям.",
    "",
    "Справочник &aStarcatcher's Guide&r показывает, где обитает каждая рыба, какую наживку она предпочитает и насколько сильно сопротивляется. Запись остаётся скрытой до тех пор, пока вы не поймаете эту рыбу хотя бы один раз.",
  ],
  "quest.10BE7DAF2BEAF714.quest_desc": [
    "Два небольших блока для хранения на кухне.",
    "",
    "Нажмите ПКМ по банке для печенья (&aCookie Jar&r), чтобы открыть её пять слотов. Всё, что лежит внутри, считается кухонным хранилищем, поэтому кулинарный стол (Cooking Table) может использовать эти ингредиенты.",
    "",
    "Банка для молока (&aMilk Jar&r) хранит молоко для рецептов. Нажмите ПКМ ведром молока, чтобы наполнить её, или пустым ведром, чтобы забрать ведро молока обратно.",
    "",
    "Банка для молока также нужна для создания коровы в банке (&aCow in a Jar&r), так что сделайте запасную.",
  ],
  "quest.287E6819DB849CD4.title": "&fСтойка для инструментов",
  "quest.764201B687CCFD38.title": "&aАквариумы",
  "quest.4145FED51D1ACD76.quest_desc": [
    "Незерский нарост — основа практически каждого зелья, и каждая партия зелий начинается с нароста, найденного в крепости или бастионе.",
    "",
    "Дома он растёт на &aпеске душ&r, не требует ни воды, ни света, и ему всё равно, в каком измерении находиться. Принесите песок душ вместе с наростом.",
  ],
  "quest.0800E48C01F45F46.quest_desc": [
    "Кусты сладких ягод растут в диком виде в тайге. Сломайте куст, и вы подберёте его целиком, так что одна вылазка обеспечит целую грядку дома.",
    "",
    "Они высаживаются на траву или землю без вспашки, что делает их наименее требовательной едой в сборке. Мод Pantry for Blockheads также убирает замедление и урон от кустов, так что вы можете спокойно ходить прямо сквозь них.",
  ],
  "quest.31BD9A98AE5893B9.title": "&fПолка для специй",
  "quest.5DBBF2E8AEFB4149.quest_desc": [
    "&ePantry for Blockheads&r — кулинарная часть семейства Blockheads, и она огромна: около сотни ингредиентов и готовых блюд.",
    "",
    "Эта глава знакомит с основами, необходимыми для старта. Что касается самой еды, &aсверяйтесь с JEI&r, а не со списком квестов.",
    "",
    "Основную работу выполняют три инструмента:",
    "- &aChef's Knife&r для разделки и подготовки.",
    "- &2Frying Pan&r для всего, что жарится.",
    "- &aBaking Sheet&r для всего, что выпекается.",
    "",
    "Они встраиваются в кухню Cooking for Blockheads, которую вы уже построили.",
  ],
  "quest.709DACF3C4655662.quest_desc": [
    "У вас наверняка скопилась куча разнообразных ингредиентов для готовки, и вам вряд ли хочется тратить всё время на поиск рецептов в JEI.",
    "",
    "Сложите всё в кухонную тумбу (&aKitchen Counter&r) или навесной шкафчик (&2Cabinet&r)! Пока они подключены к &bкухонному мультиблоку&r, вы можете использовать большинство рецептов через кулинарный стол (Cooking Table).",
  ],
  "quest.014A81275259E6AF.title": "&6Жёрнов на конной тяге",
  "quest.79CC3BBEC8B16640.title": "&fХолодильники",
  "quest.29C505C5D1927614.quest_desc": [
    "Первое зелье, которое действительно стоит носить с собой. Сварите &aнезерский нарост&r в колбе с водой для получения &2неловкого зелья (Awkward Potion)&r, затем добавьте сверкающий ломтик арбуза.",
    "",
    "Оно восстанавливает здоровье мгновенно, а не постепенно, что часто решает исход тяжёлого боя.",
    "",
    "Добавьте &aсветопыль&r для усиления исцеления или &2порох&r, чтобы сделать зелье взрывным.",
  ],
  "quest.4498067DF133EEFD.quest_desc": [
    "Летающие существа помещаются в вольер (&aAviary&r), будучи пойманными сетью &2Avian Net&r.",
    "",
    "Особенно выгодно содержать пчёл. Покормите их небольшим цветком для размножения, и со временем они будут накапливать пыльцу. Ножницы срезают её в виде медовых сот, а стеклянная колба собирает мёд.",
    "",
    "&7&oПопугаи, летучие мыши и тихони (allay) здесь носят декоративный характер, хотя тихоня при кормлении осколком аметиста размножается.&r",
  ],
  "quest.4B4358B6B25DC413.title": "&bStarcatcher",
  "quest.46223192C9DD4975.quest_desc": [
    "Кухня считается единым целым, только если её блоки соприкасаются. Заполняйте промежутки или углы между рядами тумб с помощью &aKitchen Connectors&r. Для проходов, где нужно ходить, используйте плитку &2Kitchen Floor&r, которая соединяет кухонную сеть под полом.",
    "",
    "&aChicken Sink&r — это курятник, а не источник воды. Нажмите ПКМ яйцом по раковине, и через 10 минут вылупится цыплёнок. Чтобы вырасти, ему нужны семена в слоте корма, а выросшая курица несёт яйца, которые кухонные рецепты могут использовать напрямую.",
    "",
    "Тумбы, шкафчики, раковины, курятники, духовки, холодильники, кулинарные столы и соединители доступны во всех 16 цветах красителей, если для вас важен дизайн кухни.",
  ],
  "quest.3257746A213CB9B7.quest_desc": [
    "&aTournament Stand&r проводит рыболовные соревнования, а радар рыбы (&2Fish Radar&r) сообщает, какие виды водятся в месте, где вы стоите.",
    "",
    "Трофеи бывают &6медными&r, &fжелезными&f, золотыми, &bалмазными&r и &aизумрудными&r, а также есть &6Trophy Of The Older Angler&r для тех, кто завершит всю коллекцию.",
    "",
    "&7&oПоедание рыбы из Starcatcher оставляет рыбьи кости (Fish Bones), у которых есть собственные применения.&r",
  ],
  "quest.7B3B55130DE2D019.quest_desc": [
    "Рабочая станция мода и единственный блок, который вам действительно необходимо построить.",
    "",
    "&7&oПосмотрите рецепты Artisan Press в JEI, чтобы увидеть всё, что он может производить.&r",
  ],
  "quest.7D090A60681CC97D.quest_desc": [
    "Кулинарный стол (&aCooking Table&r) — первый крупный предмет, который вы захотите создать для обустройства кухни!",
    "",
    "Этот блок служит главным верстаком для приготовления блюд и центральным элементом вашего &aкухонного мультиблока&r. При открытии он покажет все блюда, которые вы можете приготовить на основе хранящихся в мультиблоке продуктов и подключенных приборов.",
    "",
    "Примечание: приборы из некоторых модов не подключаются к нему (например, &bкастрюля из Farmer's Delight&r). Всегда проверяйте JEI для уточнения конкретных рецептов! ",
  ],
  "quest.35865030C4D59D8C.title": "&bМодуль льда",
  "quest.3A11543E54EFD7D9.quest_desc": [
    "Фермерство производит отходы, а &eAgritech&r их сжигает.",
    "",
    "&aCrude Biomass&r (сырая биомасса) — стартовое топливо, и оно, по словам самого мода, крайне неэффективно. Настоящая &2Biomass&r получается только в компостере (&aComposter&r) из квеста по компосту и мульче. Спрессуйте её в спрессованную биомассу, а затем в блок спрессованной биомассы — каждый этап содержит больше энергии, чем предыдущий.",
    "",
    "Горелка биомассы (&aBiomass Burner&r) превращает любой из этих видов топлива в &cRF&r, которая питает остальные механизмы. Ферма, обеспечивающая себя энергией за счёт собственных отходов — главная идея мода.",
  ],
  "quest.6D8485CEF00C0B60.title": "&2Культуры Blockhead",
  "quest.308D28C1370CED08.quest_desc": [
    "Компостер (&aComposter&r) превращает растительные отходы в &2биомассу (Biomass)&r. Он принимает всё то же, что и ванильный компостер, и работает быстрее при подаче энергии, хотя функционирует и без неё.",
    "",
    "Биомасса прессуется в ингредиенты для мульчи (&aMulch&r). В слоте почвы плантера мульча даёт &a50%&r к скорости роста цветов, саженцев, грибов и всего остального, что растёт на земле.",
    "{@pagebreak}",
    "Культуры, требующие пашни, не примут простую мульчу. Нажмите по ней в плантере ПКМ &2мотыгой&r, и она превратится в &aInfused Farmland&r (насыщенную пашню), что удваивает бонус до &a100%&r, а также работает в открытом мире как обычная пашня.",
    "",
    "Это также единственная почва, которую принимают любые семена эссенций из &eMystical Agriculture&r. Обычная пашня в плантере позволяет выращивать семена эссенций только 1-го уровня, поэтому если семя не сажается, этот блок решит проблему.",
  ],
  "quest.308D28C1370CED08.title": "&aКомпост, мульча и насыщенная пашня",
  "quest.6B7CE7931C91B128.quest_desc": [
    "Здесь ферма перестаёт нуждаться в вашем присутствии.",
    "",
    "Распылитель удобрений (&aFertilizer Spreader&r) самостоятельно удобряет каждый плантер в радиусе действия, а силос (&2Silo&r) собирает с них урожай и хранит его.",
    "",
    "Оба устройства работают по радиусу, поэтому вопрос планировки сводится к тому, сколько плантеров вы сможете уместить в зоне действия одного распылителя.",
  ],
  "quest.1E0BB50868F951A3.quest_desc": [
    "Корзина для фруктов (&aFruit Basket&r) — по сути ещё один блок хранения для вашего &bкухонного мультиблока&r, но в ней можно красиво и наглядно размещать &2фрукты&r!",
  ],
  "quest.6BDDB9A4E1E30213.quest_desc": [
    "Для старта животное вовсе не обязательно. Два блока работают исключительно на вашей мускульной силе:",
    "",
    "- &aHand Grindstone&r перемалывает без лошади.",
    "- &2Chopping Block&r рубит дерево тоже без неё.",
    "",
    "Они медленнее версий на конной тяге и требуют вашего постоянного присутствия, но стоят сущие копейки и доступны с самого первого дня.",
    "",
    "В JEI ручное перемалывание (Manual Grinding) и ручная рубка (Manual Chopping) вынесены в отдельные категории от конных механизмов. Проверяйте обе.",
  ],
  "quest.52F610F471E53EFB.quest_desc": [
    "Улучшенный плантер (&aAdvanced Planter&r) выращивает культуры вдвое быстрее базового и имеет два слота для модулей улучшения скорости (Speed) и урожайности (Yield), которых нет у обычного плантера.",
    "",
    "Он работает от энергии: потребляет &c128 RF/t&r во время работы и останавливается, когда заряд иссякает, поэтому держите его рядом с &aконденсатором (Capacitor)&r.",
  ],
  "quest.073546F80EDA632E.quest_desc": [
    "Нужны конкретные семена для фермы? Загляните на местный фермерский &aрынок (Market)&r!",
    "",
    "После установки блока появится местный фермер, продающий большинство семян и предметов, необходимых для процветающего хозяйства.",
    "",
    "&aРынок&r избавляет от долгих странствий, когда вам срочно нужна культура, которую вы ещё не отыскали в мире.",
    "{image:minecraft:item/emerald width:20 height:20 align:center}",
  ],
  "quest.72EAA9618A3E114D.quest_desc": [
    "Вся хитрость — в уровне почвы. Каждому семени эссенции требуется почва соответствующего уровня, поэтому семя &51-го уровня&r будет расти в том плантере, где семя &d5-го уровня&r откажется.",
    "",
    "Продвигаясь по цепочке &5Inferium &r&f→&f&d Prudentium &r&f→&f Tertium &f→&f Imperium &f→&f Supremium, вам придётся пропорционально улучшать и уровень почвы.",
    "",
    "Плантеры также дают &5Fertilized Essence&r вместе с урожаем и периодически возвращают само семя, так что ферма эссенций постепенно окупает собственное расширение.",
    "",
    "Проверяйте в JEI любое семя эссенции, чтобы узнать, какой уровень почвы ему требуется.",
  ],
  "quest.764201B687CCFD38.quest_desc": [
    "&aAquatic Jar&r и &2аквариумы (Aquariums)&r выполняют ту же функцию для рыб, спрутов и дельфинов.",
    "",
    "Ловите их банкой и заселяйте аквариум точно так же, как загон для скота. Рыбы размножаются морской травой или ламинарией, а спруты и дельфины — любой рыбой.",
    "",
    "Меч или топор собирают с них добычу, а ведро с водой позволяет зачерпнуть рыбу живьём.",
  ],
  "quest.4DE0274AAFD9BF94.quest_desc": [
    "Ещё два блока, работающие без помощи животных.",
    "",
    "- &aСушилка (Drying Rack)&r: со временем высушивает положенные на неё предметы. Jade показывает прогресс и оставшееся время.",
    "- &aГранитная наковальня (Granite Anvil)&r: ручной дробитель. Положите на неё блок и ударьте киркой, чтобы расколоть камень в булыжник, булыжник в гравий, а гравий в песок.",
    "",
    "Огниво из кремня и трута (Flint and Tinder) — решение мода на случай, если вам нужен огонь до появления железа.",
  ],
  "quest.3AAE0A3262894C43.title": "&2Конденсаторы",
  "task.1DBF06AF493A4F76.title": "Любой &aзагон для животных&r",
  "quest.02B468BF096A840A.quest_desc": [
    "Вторая часть истории о совместимости.",
    "",
    "&eProductive Farming&r применяет свою систему свойств (traits) как к культурам &eMystical Agriculture&r, так и к своим собственным. Эссенциевые культуры могут обладать характеристиками Growth (рост), Yield (урожайность), Resistance (устойчивость) и Mutability (мутагенность) точно так же, как и кукуруза. Каждый раз, когда растение переходит на новую стадию роста, у него есть шанс повысить характеристику: от 6% для семян 1-го уровня до 1% для 6-го уровня.",
    "",
    "Пыльца не действует на культуры эссенций, так как у них нет мутаций. Выведите сорт &5инферия (Inferium)&r с урожайностью &cVery High&r, пересевая семена с ваших лучших растений по мере роста характеристик. Затем выращивайте его в плантере &eAgritech&r на &2насыщенной пашне (Infused Farmland)&r под &aколпаком (Cloche Dome)&r и собирайте урожай силосом (Silo).",
    "",
    "&7&oТри мода, одна ферма эссенций, и всё это работает абсолютно без вашего участия.&r",
  ],
  "quest.23FFD172C3555282.quest_desc": [
    "При подключении к &bкухонному мультиблоку&r плита (&aStove&r) открывает доступ к рецептам, требующим обычной печи или коптильни, пока в ней есть топливо.",
    "",
    "Этот кухонный прибор может готовить до 9 предметов одновременно!",
  ],
  "quest.11C072E618300154.quest_desc": [
    "Иногда на крючке оказывается что-то значительно более увесистое. Это &6сокровище&r.",
    "",
    "Чтобы вытащить его, нужно попадать по &6золотым зонам (gold sweetspots)&r, параллельно вываживая саму рыбу — схватка становится сложнее, но награда того стоит. Большинство сокровищ берутся из ванильной таблицы сокровищ рыбалки, однако некоторые редкие виды несут в себе кузнечный шаблон для облика удочки или снастей.",
    "",
    "&aПослание в бутылке (Message in a Bottle)&r не считается сокровищем. Это самостоятельный улов, причём каждое послание можно выловить лишь единожды. Первые появляются на высоте Y 50 и выше после поимки 10 редких рыб. Для других требуется 15 редких или 10 эпических уловов, легендарный улов и лава на поверхности, либо череп визер-скелета в качестве наживки.",
    "",
    "&7&oЖадность губит улов. Если зайти в борьбе слишком далеко, можно потерять и рыбу, и сокровище.&r",
  ],
  "quest.3A389EDA045B65E1.title": "&fФерма моркови",
  "quest.1A64C6CE416B7C5E.title": "&dТри системы рыбалки",
  "quest.2545259D5B8A6139.quest_desc": [
    "Ещё пять ванильных культур заслуживают места на вашей ферме, и ни одна из них не требует отдельного квеста.",
    "",
    "- &aСвёкла&r растёт подобно пшенице из семян, найденных в деревнях и сундуках.",
    "- &2Тыквы&r и &aарбузы&r растут на стеблях, а плод появляется на соседнем свободном блоке земли, травы или пашни, поэтому оставляйте место рядом со стеблем.",
    "- &aСахарный тростник&r растёт на земле или песке у воды до трёх блоков в высоту. Срезайте верхние блоки, оставляя основание.",
    "- &2Светящиеся ягоды&r собираются с пещерных лиан в пышных пещерах и растут вниз от нижней грани блока.",
  ],
  "quest.7D090A60681CC97D.title": "&fОбустройство вашей кухни",
  "quest.10963E2F6AEC9B3B.quest_desc": [
    "Три семейства модулей, по три уровня в каждом.",
    "",
    "- &aРадиус MK1/2/3 (Range)&r увеличивает дальность работы &2силоса&r или распылителя удобрений на 16, 32 или 64 блока.",
    "- &aСкорость MK1/2/3 (Speed)&r заставляет механизмы работать быстрее.",
    "- &2Урожайность MK1/2/3 (Yield)&r увеличивает количество продукции за каждый сбор урожая.",
    "",
    "&7&oОдин модуль радиуса MK3 превращает единственный распылитель в источник удобрений для всей вашей фермы.&r",
  ],
  "quest.154E08BC9091684F.title": "&aСветопыль",
  "quest.6BDDB9A4E1E30213.title": "&6Ручной труд",
  "quest.76F225C6B9A79620.quest_desc": [
    "Чтобы сварить практически любое зелье, сначала потребуется приготовить &aнеловкое зелье (Awkward Potion)&r.",
    "",
    "Оно станет вашей универсальной основой!",
  ],
  "quest.15441C87BEDC510C.quest_desc": [
    "&eAgritech Evolved&r — это механизированное сельское хозяйство. Вместо того чтобы вручную вспахивать поле и бегать по нему с мотыгой, вы строите &aплантеры (Planters)&r и доверяете выращивание им.",
    "",
    "&aПлантер&r вмещает почву и культуру. Нажмите по нему ПКМ &aмотыгой&r, чтобы вспахать заложенную почву, и ПКМ &2костной мукой&r или любым удобрением, чтобы ускорить рост.",
    "",
    "Плантеры бывают из всех видов древесины, так что выбирайте тот, который лучше всего вписывается в интерьер вашей постройки.",
    "",
    "Плантер также улучшает высаженное семя во время работы. Перед каждым сбором урожая у посаженного семени есть шанс повысить одно из своих свойств из &eProductive Farming&r: 7% для большинства культур и от 6% до 1% для семян &eMystical Agriculture&r. Growth ускоряет работу плантера, Yield увеличивает количество собираемого урожая, а все выпадающие семена наследуют свойства посаженного растения.",
  ],
  "quest.3C972EE25114E1AE.quest_desc": [
    "До электричества, до пара была лошадь, ходящая по кругу.",
    "",
    "&eHorse Powered&r — это обработка ресурсов ранней игры, не требующая никакой энергии. Каждый механизм работает двумя способами: приводите его в действие &2вручную&r (медленно) или привяжите животное рабочим седлом &aWork Saddle&r и позвольте ему выполнять работу за вас.",
    "",
    "Мод даёт вам муку, растительное масло, доски, сушёные продукты и начальную энергию задолго до появления технологических модов.",
    "",
    "[\"\", {\"text\": \"Возьмите \", \"color\": \"gray\", \"italic\": true}, {\"text\": \"Horse Powered Guide\", \"color\": \"aqua\", \"underlined\": true, \"italic\": true, \"click_event\": {\"action\": \"custom\", \"id\": \"ftbquests:docs\", \"payload\": {\"location\": \"guideme,horsepowered:guide,horsepowered:index.md\"}}, \"hover_event\": {\"action\": \"show_text\", \"value\": \"Открыть Horse Powered Guide\"}}, {\"text\": \". В нём описаны все механизмы и оба режима работы.\", \"color\": \"gray\", \"italic\": true}]",
  ],
  "quest.67E0794BC2E568C1.quest_desc": [
    "Разделочная доска (&aCutting Board&r) — это плоский верстак. Нажмите ПКМ, чтобы открыть обычную сетку крафта 3x3.",
    "",
    "Она не подключается к кухонной сети, поэтому не имеет доступа к содержимому ваших тумб. Берите ингредиенты с собой в инвентарь.",
  ],
  "quest.76F225C6B9A79620.title": "&fНеловкое зелье",
  "task.6CDD4C0D99BEAE16.title": "Любой &aвольер&r",
  "quest.586A4F3BBC9F7275.quest_desc": [
    "Поместите моллюска (&aClam&r) на песок, и внутри него постепенно вырастет &fжемчужина (Pearl)&f. Когда створки раскроются, кликните по нему для сбора.",
    "",
    "Из жемчужин также изредка выпадает кузнечный шаблон &aPearl Tackle Smithing Template&r.",
  ],
  "quest.24E11CBBB6EC58D5.quest_desc": [
    "Огненный порошок — это топливо для работы &aзельеварки&r, и он добывается из огненных стержней ифритов в незерских крепостях.",
    "",
    "Один стержень даёт две единицы порошка, а одной единицы хватает на несколько циклов варки. Принесите больше стержней, чем планировали: добрая половина всё равно уйдёт на создание очей Края.",
  ],
  "quest.59BFB93E613911CD.title": "&5Удочки и рыбалка в лаве",
  "quest.3879EE0C19E79053.title": "&6Дроводёр на конной тяге",
  "quest.47C84A22986E6A81.quest_desc": [
    "Два бытовых прибора, работающих автономно вне кухонной сети.",
    "",
    "Нажмите ПКМ хлебом по тостеру (&aToaster&r), чтобы загрузить два ломтика, затем нажмите ПКМ пустой рукой, чтобы включить его. Через минуту выскочит поджаренный хлеб (Toasted Bread). Поджарьте его повторно — и получите древесный уголь.",
    "{@pagebreak}",
    "Он также поджаривает картофель, ламинарию, плоды хоруса, кукурузу и снежки — по две штуки за раз. Это медленнее печи, зато не требует топлива.",
    "",
    "Кофемашина (&aCoffee Machine&r) варит &2кофе&r. Возьмите в руку колбу с водой, держите какао-бобы в инвентаре и нажмите ПКМ по кофемашине. На каждую чашку расходуется одна колба и один боб, а выпитый кофе даёт спешку (Haste) и скорость (Speed) на полторы минуты.",
    "",
    "Не зажимайте Shift при нажатии, иначе вы просто выпьете воду.",
  ],
  "quest.4C50A70027F208BE.title": "&dВремя для пира",
  "quest.6F6671705176E2F8.quest_desc": [
    "При добавлении в зелья &cредстоун&r увеличивает длительность действия эффектов.",
  ],
  "quest.4145FED51D1ACD76.title": "&fНезерский нарост",
  "quest.67E0794BC2E568C1.title": "&fРазделочная доска",
  "quest.35865030C4D59D8C.quest_desc": [
    "&bIce Upgrade&r можно установить в холодильник, чтобы добавить рецепты со льдом и снегом в &bкухонный мультиблок&r.",
  ],
  "task.5C621DC20ED224E0.title": "Кухонные тумбы",
  "quest.3670FA7818A11284.title": "&fВремя &dзельеварения",
  "quest.514E3A822BFB730B.quest_desc": [
    "Множество кулинарных рецептов требует &bмолока&r, и вам вряд ли захочется каждый раз бегать к ближайшей корове с ведром.",
    "",
    "Именно поэтому стоит обзавестись коровой в банке (&6Cow in a Jar&r). Будучи подключённой к &bкухонному мультиблоку&r, она обеспечивает рецепты молоком всякий раз, когда оно необходимо.",
    "",
    "Но как её получить? Сначала создайте банку для молока (&aMilk Jar&r). Она может просто хранить молоко, но вам ведь нужен бесконечный источник молока для кухни.",
    "{@pagebreak}",
    "Затем выкопайте яму подходящего размера, чтобы туда поместилась корова, и поставьте Milk Jar на дно.",
    "",
    "Заманите корову в яму прямо на банку для молока, а затем сбросьте на неё наковальню. Это утрамбует корову прямо внутрь банки!",
    "",
    "После этого банка будет постепенно и бесконечно производить молоко для вашей кухни.",
  ],
  "quest.10AB0C0930A5D77D.quest_desc": [
    "Неловкое зелье плюс &aслеза гаста&r. Слеза — самая сложная часть, ведь гасты любят ронять её прямо в моря лавы в Незере.",
    "",
    "Регенерация лечит постепенно, а не мгновенно, поэтому её лучше пить перед боем, а не в разгар сражения. &aРедстоуновая пыль&r увеличивает её длительность.",
  ],
  "task.32F204C4D02EF945.title": "Любой #starcatcher:bobbers"
}